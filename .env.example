# Names only (Section 2.10.5). Copy to .env and fill in; .env is never committed.

# Backend only; empty means the advisor chat runs in fallback mode.
ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./data/aegis.db
SESSION_TTL_HOURS=8

# Frontend server: where the /api rewrite sends requests (the api service in Docker Compose).
API_BASE_URL=http://api:8000
# Frontend: 1 = Mock Service Worker answers /api/* in the browser, 0 = use the real backend.
NEXT_PUBLIC_API_MOCK=0
