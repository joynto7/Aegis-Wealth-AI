# Names only (Section 2.10.5). Copy to .env and fill in; .env is never committed.
# docker compose reads ANTHROPIC_API_KEY and SESSION_TTL_HOURS from here; the rest have working defaults.

# Backend only. Empty means the advisor chat runs in fallback mode (checked templates).
ANTHROPIC_API_KEY=
SESSION_TTL_HOURS=8

# Set by compose.yaml for Docker; for local runs the default is backend/data/aegis.db.
# DATABASE_URL=sqlite:///./data/aegis.db

# Frontend (build time): 1 = in-browser mock API, 0 = the real backend through the /api rewrite.
NEXT_PUBLIC_API_MOCK=0
API_BASE_URL=http://api:8000

# Optional backend settings (defaults shown).
# AEGIS_MODEL=claude-opus-5-5
# LLM_TIMEOUT_SECONDS=20
# COOKIE_SECURE=0                 # set 1 behind HTTPS
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# TRUST_PROXY_HEADERS=0           # compose.yaml sets 1: requests arrive through the web container
# BCRYPT_ROUNDS=12
# LOGIN_ATTEMPTS_PER_MINUTE=10
# CHAT_MESSAGES_PER_MINUTE=20
# LOCKOUT_THRESHOLD=5
# LOCKOUT_MINUTES=5
# DEMO_PASSWORD=password123       # the seeded demo accounts' password
